Enter a card title.\";\n        return;\n      }\n      try {\n        await import_sdk.data.transaction([{ op: \"insert\", table: \"cards\", values: { title: title.value, x: String(20 + cards.value.rows.length % 2 * 170), y: String(25 + Math.floor(cards.value.rows.length / 2) * 90) } }]);\n        title.value = \"\";\n        status.value = \"Card saved.\";\n      } catch (error) {\n        status.value = error.message;\n      }\n    }\n    async function move(event) {\n      const row = cards.value.rows.find((row2) => row2.key === event.value);\n      if (!row) return;\n      try {\n        await import_sdk.data.transaction([{ op: \"update\", table: \"cards\", id: row.id, values: { x: String(Math.max(0, Math.min(300, Number(row.values.x) + event.x))), y: String(Math.max(0, Number(row.values.y) + event.y)) } }], { revision: cards.value.revision });\n        status.value = \"Position saved.\";\n      } catch (error) {\n        status.value = error.message;\n      }\n    }\n    return /* @__PURE__ */ Sevra.h(import_sdk.Column, { gap: 12 }, /* @__PURE__ */ Sevra.h(import_sdk.Text, { text: \"Plan your work\", size: 26, weight: \"bold\" }), /* @__PURE__ */ Sevra.h(import_sdk.Text, { text: \"Drag a card to move it. Arrow keys move the selected card.\" }), /* @__PURE__ */ Sevra.h(import_sdk.Text, { text: () => `Showing ${cards.value.rows.length} of ${cards.value.total || 0} cards.` }), /* @__PURE__ */ Sevra.h(import_sdk.Row, null, /* @__PURE__ */ Sevra.h(import_sdk.TextField, { label: \"Card title\", placeholder: \"Card title\", value: title, width: 260 }), /* @__PURE__ */ Sevra.h(import_sdk.Button, { title: \"Add card\", onClick: add })), /* @__PURE__ */ Sevra.h(import_sdk.Text, { text: status, hidden: () => !status.value }), /* @__PURE__ */ Sevra.h(\n      import_sdk.Canvas,\n      {\n        label: \"Planning board\",\n        width: 450,\n        height: () => Math.max(420, ...cards.value.rows.map((row) => Number(row.values.y) + 100)),\n        shapes: () => cards.val