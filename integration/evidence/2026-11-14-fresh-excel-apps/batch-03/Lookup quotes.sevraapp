          "type": "text"
        }
      ],
      "title": "lookup-quotes-0.xlsx · Lookup quotes",
      "writable": true
    }
  },
  "excelBehavior": {
    "actions": [],
    "gaps": [],
    "outputs": [
      "sheet1!D2"
    ],
    "source": "function recreate(input){const c=input.cells;const sku=c['sheet1!B2'];const qtyStr=c['sheet1!C2'];const lk1=c['sheet1!F2'];const pr1=c['sheet1!G2'];const lk2=c['sheet1!F3'];const pr2=c['sheet1!G3'];let price=null;if(sku!==null&&sku!==undefined&&sku.toUpperCase()===lk1.toUpperCase())price=pr1;else if(sku!==null&&sku!==undefined&&sku.toUpperCase()===lk2.toUpperCase())price=pr2;if(price===null)return{'sheet1!D2':'#N/A'};const qty=qtyStr===''?0:Number(qtyStr);if(isNaN(qty))return{'sheet1!D2':'#VALUE!'};const finalPrice=price===''?0:Number(price);if(isNaN(finalPrice))return{'sheet1!D2':'#VALUE!'};const total=finalPrice*qty;return{'sheet1!D2':String(total)};}"
  },
  "name": "Lookup quotes",
  "sdkVersion": 1,
  "source": "const {h,mount,Column,Text,TextField,Button,Table,signal,data}=Sevra;\nconst selected=signal(null),selection=signal(''),sku=signal(''),qty=signal(''),search=signal(''),busy=signal(false),status=signal('');\nfunction clear(){selected.value=null;selection.value='';sku.value='';qty.value='';}\nfunction select(e){if(busy.value)return;const r=e.value;if(!r||r.values.c1==='Quote'){clear();return;}selected.value=r;selection.value=r.key;sku.value=r.values.c2||'';qty.value=r.values.c3||'';status.value='';}\nasync function save(){if(busy.value||!selected.value)return;const row=selected.value;busy.value=true;try{await data.transaction([{op:'update',table:'sheet1',id:row.id,values:{c2:sku.value,c3:qty.value}}]);clear();status.value='Saved';}catch(e){status.value=e.message;}finally{busy.value=false;}}\nconst root=h(Column,{gap:16},h(Text,{text:'Lookup quotes',size:24,weight:'bold'}),h(TextField,{label:'Search',value:search}),h(Table,{table:'sheet1',label:'Records',search,selection,onSelect:select,height:300,enabled:()=>!busy.value}),h(Text,{text:'SKU'}),h(TextField,{label:'SKU',value:sku,enabled:()=>!busy.value&&!!selected.value}),h(Text,{text:'Quantity'}),h(TextField,{label:'Quantity',value:qty,enabled:()=>!busy.value&&!!selected.value}),h(Button,{title:'Save changes',onClick:save,enabled:()=>!busy.value&&!!selected.value}),h(Text,{text:status}));\nmount(root);"
}
