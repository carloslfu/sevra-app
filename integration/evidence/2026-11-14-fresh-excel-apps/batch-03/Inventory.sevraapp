{
  "datasets": {
    "sheet1": {
      "columns": [
        {
          "id": "c1",
          "title": "A",
          "type": "text"
        },
        {
          "id": "c2",
          "title": "B",
          "type": "text"
        },
        {
          "id": "c3",
          "title": "C",
          "type": "text"
        },
        {
          "id": "c4",
          "title": "D",
          "type": "text"
        }
      ],
      "title": "inventory-0.xlsm · Inventory",
      "writable": true
    }
  },
  "excelBehavior": {
    "actions": [
      {
        "id": "ship",
        "inputs": [
          {
            "id": "quantity",
            "title": "Quantity"
          }
        ],
        "title": "Ship stock",
        "writes": [
          "sheet1!B2"
        ]
      }
    ],
    "gaps": [],
    "outputs": [
      "sheet1!D2"
    ],
    "source": "function recreate(input){\n  const c=input.cells;\n  if(input.event==='ship'){\n    const qtyStr=input.arguments?.quantity;\n    if(typeof qtyStr!=='string'||qtyStr.trim()===''){throw new Error('Quantity is required.');}\n    const qty=Number(qtyStr);\n    if(isNaN(qty)||!isFinite(qty)||qty<=0){throw new Error('Quantity must be a positive number.');}\n    const currentStockStr=c['sheet1!B2'];\n    const currentStock=Number(currentStockStr);\n    if(isNaN(currentStock)){throw new Error('Current stock is invalid.');}\n    if(qty>currentStock){throw new Error('Quantity exceeds current stock.');}\n    const newStock=currentStock-qty;\n    return {'sheet1!B2':String(newStock)};\n  }\n  const b2Str=c['sheet1!B2'];\n  const c2Str=c['sheet1!C2'];\n  const b2=Number(b2Str);\n  const c2=Number(c2Str);\n  if(isNaN(b2)||isNaN(c2)){return {'sheet1!D2':'#VALUE!'};}\n  const toOrder=Math.max(c2-b2,0);\n  return {'sheet1!D2':String(toOrder)};\n}"
  },
  "name": "Inventory Stock Manager",
  "sdkVersion": 1,
  "source": "const {h,mount,Column,Text,TextField,Button,Table,signal,data}=Sevra;\nconst quantity=signal('');\nconst busy=signal(false);\nconst status=signal('');\nasync function shipStock(){\n  if(busy.value) return;\n  busy.value=true;\n  status.value='';\n  try{\n    await data.transaction([{op:'excel_action',action:'ship',arguments:{quantity:quantity.value}}]);\n    quantity.value='';\n    status.value='Stock shipped successfully.';\n  }catch(e){\n    status.value=e.message;\n  }finally{\n    busy.value=false;\n  }\n}\nconst root=h(Column,{gap:16},\n  h(Text,{text:'Inventory Stock Manager',size:24,weight:'bold'}),\n  h(Table,{table:'sheet1',label:'Records',height:300}),\n  h(Column,{gap:8},\n    h(Text,{text:'Ship Stock Action'}),\n    h(TextField,{label:'Quantity',value:quantity,enabled:()=>!busy.value}),\n    h(Button,{title:'Ship stock',onClick:shipStock,enabled:()=>!busy.value&&quantity.value.trim().length>0}),\n    h(Text,{text:status})\n  )\n);\nmount(root);"
}
