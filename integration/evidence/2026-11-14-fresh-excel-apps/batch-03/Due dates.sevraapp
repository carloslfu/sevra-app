{
  "datasets": {
    "sheet1": {
      "columns": [
        {
          "id": "c1",
          "title": "A",
          "type": "text"
        },
        {
          "id": "c2",
          "title": "B",
          "type": "text"
        },
        {
          "id": "c3",
          "title": "C",
          "type": "text"
        },
        {
          "id": "c4",
          "title": "D",
          "type": "text"
        }
      ],
      "title": "due-dates-0.xlsx · Due dates",
      "writable": true
    }
  },
  "excelBehavior": {
    "actions": [],
    "gaps": [],
    "outputs": [
      "sheet1!D2"
    ],
    "source": "function recreate(input){const c=input.cells;const invoiceDate=c['sheet1!B2'];const terms=c['sheet1!C2'];if(!invoiceDate||invoiceDate.trim()===''){return{'sheet1!D2':'#VALUE!'};}const termDays=terms!==undefined&&terms!==''?Number(terms):0;if(!isFinite(termDays)){return{'sheet1!D2':'#VALUE!'};}let dueDate;try{dueDate=calendar.addDays(invoiceDate,termDays);}catch(e){return{'sheet1!D2':'#VALUE!'};}return{'sheet1!D2':dueDate};}"
  },
  "name": "Due dates",
  "sdkVersion": 1,
  "source": "const {h,mount,Column,Text,TextField,Button,Table,signal,data}=Sevra;\nconst selected=signal(null),selection=signal(''),input=signal(''),search=signal(''),busy=signal(false),status=signal('');\nfunction clear(){selected.value=null;selection.value='';input.value='';}\nfunction select(e){if(busy.value)return;const r=e.value;if(!r||r.values.c1==='Invoice'){clear();return;}selected.value=r;selection.value=r.key;input.value=r.values.c2||'';status.value='';}\nasync function save(){if(busy.value||!selected.value)return;const row=selected.value,value=input.value;busy.value=true;try{await data.transaction([{op:'update',table:'sheet1',id:row.id,values:{c2:value}}]);clear();status.value='Saved';}catch(e){status.value=e.message;}finally{busy.value=false;}}\nconst root=h(Column,{gap:16},h(Text,{text:'Due dates',size:24,weight:'bold'}),h(TextField,{label:'Search',value:search}),h(Table,{table:'sheet1',label:'Records',search,selection,onSelect:select,height:300,enabled:()=>!busy.value}),h(Text,{text:'Invoice date'}),h(TextField,{label:'Invoice date',value:input,enabled:()=>!busy.value&&!!selected.value}),h(Button,{title:'Save changes',onClick:save,enabled:()=>!busy.value&&!!selected.value}),h(Text,{text:status}));\nmount(root);"
}
