{
  "datasets": {
    "sheet1": {
      "columns": [
        {
          "id": "c1",
          "title": "A",
          "type": "text"
        },
        {
          "id": "c2",
          "title": "B",
          "type": "text"
        },
        {
          "id": "c3",
          "title": "C",
