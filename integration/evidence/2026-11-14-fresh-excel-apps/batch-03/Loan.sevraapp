{
  "datasets": {
    "sheet1": {
      "columns": [
        {
          "id": "c1",
          "title": "A",
          "type": "text"
        },
        {
          "id": "c2",
          "title": "B",
          "type": "text"
        },
        {
          "id": "c3",
          "title": "C",
          "type": "text"
        },
        {
          "id": "c4",
          "title": "D",
          "type": "text"
        },
        {
          "id": "c5",
          "title": "E",
          "type": "text"
        }
      ],
      "title": "loan-0.xlsx · Loan",
      "writable": true
    }
  },
  "excelBehavior": {
    "actions": [],
    "gaps": [],
    "outputs": [
      "sheet1!D2"
    ],
    "source": "function recreate(input){const c=input.cells;const getNum=(k)=>{const v=c[k];if(v===''||v===undefined)return 0;const n=Number(v);if(isNaN(n))return NaN;return n;};const pv=getNum('sheet1!B2');const rate=getNum('sheet1!C2');const nper=getNum('sheet1!E2');if(isNaN(pv)||isNaN(rate)||isNaN(nper)){return {'sheet1!D2':'#VALUE!'};}if(nper<0||rate<=-1){return {'sheet1!D2':'#NUM!'};}if(nper===0){return {'sheet1!D2':'#NUM!'};}let pmtVal;if(rate===0){pmtVal=pv/nper;}else{const pow=Math.pow(1+rate,-nper);const denom=1-pow;if(denom===0){return {'sheet1!D2':'#DIV/0!'};}pmtVal=rate*pv/denom;}const roundExcel=(num,dec)=>{const factor=Math.pow(10,dec);const sign=num>=0?1:-1;const absNum=Math.abs(num);const shifted=absNum*factor;const floor=Math.floor(shifted);const frac=shifted-floor;let result;if(Math.abs(frac-0.5)<1e-9){result=(floor+1)*sign;}else{result=Math.round(shifted)*sign;}return result/factor;};const finalPayment=roundExcel(pmtVal,2);return {'sheet1!D2':String(finalPayment)};}"
  },
  "name": "Loan",
  "sdkVersion": 1,
  "source": "const {h,mount,Column,Text,TextField,Button,Table,signal,data}=Sevra;\nconst selected=signal(null),selection=signal(''),principal=signal(''),search=signal(''),busy=signal(false),status=signal('');\nfunction clear(){selected.value=null;selection.value='';principal.value='';}\nfunction select(e){if(busy.value)return;const r=e.value;if(!r||r.values.c1==='Loan'){clear();return;}selected.value=r;selection.value=r.key;principal.value=r.values.c2||'';status.value='';}\nasync function save(){if(busy.value||!selected.value)return;const row=selected.value,value=principal.value;busy.value=true;try{await data.transaction([{op:'update',table:'sheet1',id:row.id,values:{c2:value}}]);clear();status.value='Saved';}catch(e){status.value=e.message;}finally{busy.value=false;}}\nconst root=h(Column,{gap:16},h(Text,{text:'Loan Workspace',size:24,weight:'bold'}),h(TextField,{label:'Search',value:search}),h(Table,{table:'sheet1',label:'Records',search,selection,onSelect:select,height:300,enabled:()=>!busy.value}),h(Text,{text:'Principal'}),h(TextField,{label:'Principal',value:principal,enabled:()=>!busy.value&&!!selected.value}),h(Button,{title:'Save changes',onClick:save,enabled:()=>!busy.value&&!!selected.value}),h(Text,{text:status}));\nmount(root);"
}
