{
  "datasets": {
    "sheet1": {
      "columns": [
        {
          "id": "c1",
          "title": "A",
          "type": "text"
        },
        {
          "id": "c2",
          "title": "B",
          "type": "text"
        },
        {
          "id": "c3",
          "title": "C",
          "type": "text"
        },
        {
          "id": "c4",
          "title": "D",
          "type": "text"
        }
      ],
      "title": "due-dates-0.xlsx · Due dates",
      "writable": true
    }
  },
  "excelBehavior": {
    "actions": [],
    "gaps": [],
    "outputs": [
      "sheet1!D2"
    ],
    "source": "function recreate(input) {\n    const c = input.cells;\n    const b2 = c['sheet1!B2'];\n    const c2 = c['sheet1!C2'];\n    if (!b2 || b2.trim() === '') {\n        return { 'sheet1!D2': '#VALUE!' };\n    }\n    let terms = 0;\n    if (c2 && c2.trim() !== '') {\n        const parsed = Number(c2);\n        if (isNaN(parsed)) {\n            return { 'sheet1!D2': '#VALUE!' };\n        }\n        terms = parsed;\n    }\n    try {\n        const dueDate = calendar.addDays(b2, terms);\n        return { 'sheet1!D2': dueDate };\n    } catch (e) {\n        return { 'sheet1!D2': '#VALUE!' };\n    }\n}"
  },
  "name": "Due dates",
  "sdkVersion": 1,
  "source": "const {h, mount, Column, Text, TextField, Button, Table, signal, data} = Sevra;\n\nconst selected = signal(null);\nconst selection = signal('');\nconst invoiceDate = signal('');\nconst search = signal('');\nconst busy = signal(false);\nconst status = signal('');\n\nfunction clear() {\n    selected.value = null;\n    selection.value = '';\n    invoiceDate.value = '';\n}\n\nfunction select(e) {\n    if (busy.value) return;\n    const r = e.value;\n    if (!r || r.values.c1 === 'Invoice') {\n        clear();\n        return;\n    }\n    selected.value = r;\n    selection.value = r.key;\n    invoiceDate.value = r.values.c2 || '';\n    status.value = '';\n}\n\nasync function save() {\n    if (busy.value || !selected.value) return;\n    const row = selected.value;\n    const value = invoiceDate.value;\n    busy.value = true;\n    try {\n        await data.transaction([{\n            op: 'update',\n            table: 'sheet1',\n            id: row.id,\n            values: { c2: value }\n        }]);\n        clear();\n        status.value = 'Saved';\n    } catch (e) {\n        status.value = e.message;\n    } finally {\n        busy.value = false;\n    }\n}\n\nconst root = h(Column, { gap: 16 },\n    h(Text, { text: 'Due dates', size: 24, weight: 'bold' }),\n    h(TextField, { label: 'Search', value: search }),\n    h(Table, { table: 'sheet1', label: 'Records', search, selection, onSelect: select, height: 300, enabled: () => !busy.value }),\n    h(Text, { text: 'Invoice date' }),\n    h(TextField, { label: 'Invoice date', value: invoiceDate, enabled: () => !busy.value && !!selected.value }),\n    h(Button, { title: 'Save changes', onClick: save, enabled: () => !busy.value && !!selected.value }),\n    h(Text, { text: status })\n);\n\nmount(root);"
}
