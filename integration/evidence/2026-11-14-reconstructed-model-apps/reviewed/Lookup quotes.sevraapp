{"datasets":{"sheet1":{"columns":[{"id":"c1","title":"A","type":"text"},{"id":"c2","title":"B","type":"text"},{"id":"c3","title":"C","type":"text"},{"id":"c4","title":"D","type":"text"},{"id":"c5","title":"E","type":"text"},{"id":"c6","title":"F","type":"text"},{"id":"c7","title":"G","type":"text"}],"datasetID":"850562ca-4f42-4d30-977e-54a7fb49d2b0","title":"lookup-quotes-0.xlsx \u00b7 Lookup quotes","writable":true}},"excelBehavior":{"actions":[],"gaps":[],"outputs":["sheet1!D2"],"source":"function recreate(input){const c=input.cells,sku=c['sheet1!B2'].toLowerCase();let price;if(sku===c['sheet1!F2'].toLowerCase())price=c['sheet1!G2'];else if(sku===c['sheet1!F3'].toLowerCase())price=c['sheet1!G3'];else return {'sheet1!D2':'#N/A'};const p=Number(price),q=Number(c['sheet1!C2']);return {'sheet1!D2':Number.isFinite(p)&&Number.isFinite(q)?String(p*q):'#VALUE!'};}"},"name":"Lookup quotes","sdkVersion":1,"source":"const {h,mount,Column,Text,TextField,Button,Table,signal,data}=Sevra;\nconst selected=signal(null),selection=signal(''),quoteInput=signal(''),skuInput=signal(''),qtyInput=signal(''),search=signal(''),busy=signal(false),status=signal(''),totalDisplay=signal('');\nfunction clear(){selected.value=null;selection.value='';quoteInput.value='';skuInput.value='';qtyInput.value='';totalDisplay.value='';}\nfunction select(e){if(busy.value)return;const r=e.value;if(!r||r.values.c1==='Quote'){clear();return;}selected.value=r;selection.value=r.key;quoteInput.value=r.values.c1||'';skuInput.value=r.values.c2||'';qtyInput.value=r.values.c3||'';totalDisplay.value=r.values.c4||'';}\nasync function save(){if(busy.value||!selected.value)return;const row=selected.value,quote=quoteInput.value.trim(),sku=skuInput.value.trim(),qty=qtyInput.value.trim();if(!quote||!sku||!qty){status.value='Enter Quote, SKU and Quantity';return;}busy.value=true;try{await data.transaction([{op:'update',table:'sheet1',id:row.id,values:{c1:quote,c2:sku,c3:qty}}]);clear();status.value='Saved';}catch(e){status.value=e.message;}finally{busy.value=false;}}\nconst root=h(Column,{gap:16},h(Text,{text:'Lookup quotes',size:24,weight:'bold'}),h(TextField,{label:'Search',value:search}),h(Table,{table:'sheet1',label:'Records',search,selection,onSelect:select,height:300,enabled:()=>!busy.value}),h(Text,{text:'Edit inputs'}),h(Text,{text:'Quote'}),h(TextField,{label:'Quote',value:quoteInput,enabled:()=>!busy.value&&!!selected.value}),h(Text,{text:'SKU'}),h(TextField,{label:'SKU',value:skuInput,enabled:()=>!busy.value&&!!selected.value}),h(Text,{text:'Quantity'}),h(TextField,{label:'Quantity',value:qtyInput,enabled:()=>!busy.value&&!!selected.value}),h(Text,{text:()=>'Total: '+totalDisplay.value}),h(Button,{title:'Save changes',onClick:save,enabled:()=>!busy.value&&!!selected.value}),h(Text,{text:status}));\nmount(root);"}
