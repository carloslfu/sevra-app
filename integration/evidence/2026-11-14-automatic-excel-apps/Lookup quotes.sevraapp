{"datasets": {"sheet1": {"columns": [{"id": "c1", "title": "A", "type": "text"}, {"id": "c2", "title": "B", "type": "text"}, {"id": "c3", "title": "C", "type": "text"}, {"id": "c4", "title": "D", "type": "text"}, {"id": "c5", "title": "E", "type": "text"}, {"id": "c6", "title": "F", "type": "text"}, {"id": "c7", "title": "G", "type": "text"}], "title": "lookup-quotes-0.xlsx · Lookup quotes", "writable": true}}, "excelBehavior": {"actions": [], "gaps": [], "outputs": ["sheet1!D2"], "source": "function recreate(input){const c=input.cells;const sku=c['sheet1!B2'];const qtyText=c['sheet1!C2'];const lookupSku1=c['sheet1!F2'];const lookupPrice1=c['sheet1!G2'];const lookupSku2=c['sheet1!F3'];const lookupPrice2=c['sheet1!G3'];let unitPrice=null;const skuUpper=sku?sku.toUpperCase():'';const sku1Upper=lookupSku1?lookupSku1.toUpperCase():'';const sku2Upper=lookupSku2?lookupSku2.toUpperCase():'';if(skuUpper===sku1Upper)unitPrice=lookupPrice1;else if(skuUpper===sku2Upper)unitPrice=lookupPrice2;if(unitPrice===null||unitPrice===undefined)return{'sheet1!D2':'#N/A'};const priceNum=Number(unitPrice);if(unitPrice===''||unitPrice===null||unitPrice===undefined){const qty=qtyText===''?0:Number(qtyText);if(qtyText!==''&&isNaN(qty))return{'sheet1!D2':'#VALUE!'};return{'sheet1!D2':String(0)};}if(isNaN(priceNum))return{'sheet1!D2':'#VALUE!'};const qty=qtyText===''?0:Number(qtyText);if(qtyText!==''&&isNaN(qty))return{'sheet1!D2':'#VALUE!'};const total=priceNum*qty;return{'sheet1!D2':String(total)};}"}, "name": "Lookup quotes", "sdkVersion": 1, "source": "const {h,mount,Column,Text,TextField,Button,Table,signal,data}=Sevra;\nconst selected=signal(null),selection=signal(''),sku=signal(''),qty=signal(''),search=signal(''),busy=signal(false),status=signal('');\nfunction clear(){selected.value=null;selection.value='';sku.value='';qty.value='';}\nfunction select(e){if(busy.value)return;const r=e.value;if(!r||r.values.c1==='Quote'){clear();return;}selected.value=r;selection.value=r.key;sku.value=r.values.c2||'';qty.value=r.values.c3||'';status.value='';}\nasync function save(){if(busy.value||!selected.value)return;const row=selected.value;busy.value=true;try{await data.transaction([{op:'update',table:'sheet1',id:row.id,values:{c2:sku.value,c3:qty.value}}]);clear();status.value='Saved';}catch(e){status.value=e.message;}finally{busy.value=false;}}\nconst root=h(Column,{gap:16},h(Text,{text:'Lookup quotes',size:24,weight:'bold'}),h(TextField,{label:'Search',value:search}),h(Table,{table:'sheet1',label:'Records',search,selection,onSelect:select,height:300,enabled:()=>!busy.value}),h(Text,{text:'SKU',size:14,weight:'semibold'}),h(TextField,{label:'SKU',value:sku,enabled:()=>!busy.value&&!!selected.value}),h(Text,{text:'Quantity',size:14,weight:'semibold'}),h(TextField,{label:'Quantity',value:qty,enabled:()=>!busy.value&&!!selected.value}),h(Button,{title:'Save changes',onClick:save,enabled:()=>!busy.value&&!!selected.value}),h(Text,{text:status}));\nmount(root);"}
