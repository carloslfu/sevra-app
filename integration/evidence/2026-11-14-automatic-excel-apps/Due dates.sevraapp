{
  "datasets": {
    "sheet1": {
      "columns": [
        {
          "id": "c1",
          "title": "A",
          "type": "text"
        },
        {
          "id": "c2",
          "title": "B",
          "type": "text"
        },
        {
          "id": "c3",
          "title": "C",
          "type": "text"
        },
        {
          "id": "c4",
          "title": "D",
          "type": "text"
        }
      ],
      "title": "due-dates-0.xlsx \u00b7 Due dates",
      "writable": true
    }
  },
  "excelBehavior": {
    "actions": [],
    "gaps": [],
    "outputs": [
      "sheet1!D2"
    ],
    "source": "function recreate(input){const c=input.cells;const invoiceDateStr=c['sheet1!B2'];const termsStr=c['sheet1!C2'];if(!invoiceDateStr||invoiceDateStr.trim()===''){return {'sheet1!D2':'#VALUE!'};}let terms=0;if(termsStr&&termsStr.trim()!==''){const trimmed=termsStr.trim();const parsed=Number(trimmed);if(isNaN(parsed)||!isFinite(parsed)){return {'sheet1!D2':'#VALUE!'};}terms=parsed;}try{const dueDate=calendar.addDays(invoiceDateStr,terms);return {'sheet1!D2':dueDate};}catch(e){return {'sheet1!D2':'#VALUE!'};}}"
  },
  "name": "Due dates",
  "sdkVersion": 1,
  "source": "const {h,mount,Column,Text,TextField,Button,Table,signal,data}=Sevra;\nconst selected=signal(null),selection=signal(''),inputValue=signal(''),search=signal(''),busy=signal(false),status=signal('');\nfunction clear(){selected.value=null;selection.value='';inputValue.value='';}\nfunction select(e){if(busy.value)return;\nconst r=e.value;\nif(!r||r.values.c1==='Invoice'){clear();return;}\nselected.value=r;\nselection.value=r.key;\ninputValue.value=r.values.c2||'';\nstatus.value='';\n}\nasync function save(){if(busy.value||!selected.value)return;\nconst row=selected.value,value=inputValue.value;\nbusy.value=true;\ntry{\nawait data.transaction([{op:'update',table:'sheet1',id:row.id,values:{c2:value}}]);\nclear();\nstatus.value='Saved';\n}catch(e){status.value=e.message;}\nfinally{busy.value=false;}\n}\nconst root=h(Column,{gap:16},h(Text,{text:'Due dates',size:24,weight:'bold'}),h(TextField,{label:'Search',value:search}),h(Table,{table:'sheet1',label:'Records',search,selection,onSelect:select,height:300,enabled:()=>!busy.value}),h(Text,{text:'Invoice date',size:14,weight:'bold'}),h(TextField,{label:'Invoice date',value:inputValue,enabled:()=>!busy.value&&!!selected.value}),h(Button,{title:'Save changes',onClick:save,enabled:()=>!busy.value&&!!selected.value}),h(Text,{text:status}));\nmount(root);"
}
