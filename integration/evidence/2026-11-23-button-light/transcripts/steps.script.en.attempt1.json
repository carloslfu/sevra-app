    "body": {
     "arguments": {
      "code": "const parts = await sql('SELECT part, stock, reorder_level FROM parts WHERE stock < reorder_level');\nlet count = 0;\nfor (const part of parts) {\n  await sql('UPDATE parts SET stock = 2 * :reorder WHERE part = :part', {\n    reorder: part.reorder_level,\n    part: part.part\n  });\n  count++;\n}\nreturn count;"
     },
